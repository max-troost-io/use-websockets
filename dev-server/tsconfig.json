{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "baseUrl": ".",
    "paths": {
      "@maxtroost/use-websocket": ["../src/index.ts"]
    },
    "skipLibCheck": true
  },
  "include": ["vite-env.d.ts", "app/**/*", "app.config.ts", "vite.config.ts"]
}
